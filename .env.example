# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
# The SECRET key (sb_secret_... or the legacy service_role key). Run `python check_storage.py` to verify.
SUPABASE_KEY=your-supabase-secret-key

# Optional: "today" for new visits, receipts, invoices and paid dates (default America/New_York)
APP_TIMEZONE=America/New_York
# Optional: "lat,lon" so address suggestions near you come first
# ADDRESS_BIAS=26.35,-80.08
# Optional: comma-separated browser origins allowed to call the API
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
